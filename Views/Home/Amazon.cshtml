@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giao diện mô phỏng Amazon</title>
   
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" crossorigin="anonymous" />
   

    <style>
        
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: Arial, sans-serif; }
        body { background-color: #eaeded; color: #0f1111; display: flex; flex-direction: column; min-height: 100vh; }
        a { text-decoration: none; color: inherit; }

       
        .amazon-header { 
            background-color:#0f1111;
            color: #fff; 
            padding: 10px 15px; 
            position: sticky; 
            top: 0;}
        .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 12px; max-width: 1500px; margin: 0 auto; }
        .logo-link img { width: 95px; height: auto; display: block; object-fit: contain; }
        .deliver { font-size: 11px; color: #ccc; cursor: pointer; display: flex; flex-direction: column; justify-content: center; }
        .deliver b { color: #fff; font-size: 13px; }

        .search-box { display: flex; flex: 1; max-width: 800px; border-radius: 4px; overflow: hidden; border: 2px solid transparent; transition: border-color 0.2s; }
        .search-box select { padding: 0 10px; border: none; color: #555; font-size: 12px; cursor: pointer; border-right: 1px solid #ddd; outline: none; }
        .search-box input { flex: 1; padding: 10px 12px; border: none; outline: none; font-size: 14px; }
        .search-box button { background: #febd69; border: none; padding: 0 18px; cursor: pointer; font-size: 16px; color: #333; transition: background 0.2s; }
        .search-box button:hover { background: #f3a847; }

        .header-link { font-size: 12px; cursor: pointer; color: #fff; line-height: 1.2; padding: 5px; border: 1px solid transparent; border-radius: 2px; }
        .header-link:hover { border-color: #fff; }
        .header-link b { font-size: 13px; font-weight: bold; }
        .cart-box { display: flex; align-items: center; gap: 5px; }
        .cart-box i { font-size: 22px; color: #f3a847; }

       
        .sub-nav { background-color: #232f3e; padding: 8px 15px; color: #fff; }
        .sub-nav ul { display: flex; list-style: none; gap: 18px; overflow-x: auto; white-space: nowrap; max-width: 1500px; margin: 0 auto; }
        .sub-nav a { color: #fff; font-size: 13px; font-weight: 500; display: flex; align-items: center; gap: 5px; }
        .sub-nav a:hover { color: #febd69; }

       
        .main-content { flex: 1; max-width: 1500px; margin: 0 auto; width: 100%; }

        
        .hero-banner { position: relative; height: 260px; background: linear-gradient(180deg, #232f3e 0%, #37475a 100%); overflow: hidden; color: white; margin-bottom: -60px; }
        .slide { display: none; text-align: center; height: 100%; padding-top: 30px; }
        .slide.active { display: block; animation: fadeIn 0.4s ease-in-out; }
        .slide h1 { font-size: 28px; margin-bottom: 8px; }
        .banner-toys { font-size: 45px; margin-top: 10px; }
        .shop-now-btn { display: inline-block; margin-top: 10px; padding: 8px 20px; background: #ffd814; color: #111; border-radius: 20px; font-weight: bold; font-size: 13px; box-shadow: 0 2px 5px rgba(0,0,0,0.2); }
        .shop-now-btn:hover { background: #f7ca00; }
        .hero-arrow { position: absolute; top: 35%; transform: translateY(-50%); background: rgba(0,0,0,0.3); color: #fff; border: none; font-size: 28px; padding: 15px 10px; cursor: pointer; z-index: 10; border-radius: 4px; transition: background 0.2s; }
        .hero-arrow:hover { background: rgba(0,0,0,0.6); }
        .hero-arrow.left { left: 10px; }
        .hero-arrow.right { right: 10px; }

        
        .product-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; padding: 0 15px 20px; position: relative; z-index: 20; }
        .product-card { background: #fff; padding: 16px; display: flex; flex-direction: column; justify-content: space-between; border-radius: 4px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .product-card h3 { font-size: 17px; font-weight: bold; margin-bottom: 12px; color: #0f1111; }
        .tiles { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; flex: 1; }
        .tiles.one { grid-template-columns: 1fr; }
        .tile { font-size: 12px; text-align: left; color: #0f1111; cursor: pointer; }
        .tile .img { height: 105px; display: flex; align-items: center; justify-content: center; font-size: 36px; border-radius: 4px; margin-bottom: 6px; transition: transform 0.2s; }
        .tile:hover .img { transform: scale(1.02); }
        .tile .img.big { height: 210px; font-size: 65px; }
        .see-more { color: #007185; font-size: 13px; font-weight: 600; margin-top: 12px; display: inline-block; }
        .see-more:hover { color: #c7511f; text-decoration: underline; }

       
        .related { background: #fff; margin: 0 15px 20px; padding: 16px; border-radius: 4px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .related-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
        .related-header h3 { font-size: 17px; font-weight: bold; }
        .scroll-row { display: flex; gap: 15px; overflow-x: auto; padding: 5px 0 10px; scroll-behavior: smooth; }
        .prod { min-width: 160px; max-width: 160px; border: 1px solid #e7e7e7; padding: 12px; border-radius: 4px; text-align: center; background: #fff; display: flex; flex-direction: column; justify-content: space-between; transition: box-shadow 0.2s; }
        .prod:hover { box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
        .prod .img { height: 100px; font-size: 42px; display: flex; align-items: center; justify-content: center; margin-bottom: 8px; border-radius: 4px; }
        .prod p { font-size: 12px; color: #0f1111; margin-bottom: 8px; text-align: left; line-height: 1.3; }
        .prod b { color: #b12704; font-size: 14px; }
        .prod button { background: #ffd814; border: 1px solid #fcd200; border-radius: 20px; padding: 6px 12px; cursor: pointer; font-size: 12px; font-weight: 500; transition: background 0.2s; }
        .prod button:hover { background: #f7ca00; }

     
        .amazon-footer { background-color: #232f3e; color: #fff; margin-top: auto; }
        .back-to-top { background-color: #37475a; padding: 14px; text-align: center; cursor: pointer; font-size: 13px; transition: background 0.2s; }
        .back-to-top:hover { background-color: #485769; }
        .footer-links { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 30px; padding: 40px 20px; max-width: 1000px; margin: 0 auto; }
        .footer-column h4 { font-size: 14px; font-weight: bold; margin-bottom: 12px; }
        .footer-column a { display: block; color: #ddd; font-size: 12px; margin-bottom: 8px; }
        .footer-column a:hover { text-decoration: underline; }
        .footer-bottom { background-color: #131921; padding: 25px 15px; font-size: 12px; color: #ddd; text-align: center; border-top: 1px solid #3a4553; }

    </style>
</head>
<body>

    
    <header class="amazon-header">
        <div class="header-inner">
            <a class="logo-link" href="#"><img src="~/Content/Image/logo.jpg" alt="Amazon logo" /></a>
            <div class="deliver hide-md">
                <span>Deliver to</span>
                <b><i class="fas fa-map-marker-alt"></i> Viet Nam</b>
            </div>
            <div class="search-box">
                <select aria-label="Category">
                    <option>All</option>
                    <option>Fashion</option>
                    <option>Body</option>
                </select>
                <input id="q" type="text" placeholder="Search Amazon" aria-label="Search" />
                <button id="go" type="button" aria-label="Search"><i class="fas fa-search"></i></button>
            </div>
            <div class="header-link hide-md">EN</div>
            <div class="header-link">
                Hello, sign in<br><b>Account &amp; Lists</b>
            </div>
            <div class="header-link hide-md">
                Returns<br><b>&amp; Orders</b>
            </div>
            <div class="header-link cart-box">
                <i class="fas fa-shopping-cart"></i>
                <div>
                    <b id="cart" style="color:#f3a847;">0</b>
                    <b>Cart</b>
                </div>
            </div>
        </div>
    </header>

   
    <nav class="sub-nav">
        <ul>
            <li><a href="#" style="font-weight: bold;"><i class="fas fa-bars"></i> All</a></li>
            <li><a href="#">Today's Deals</a></li>
            <li><a href="#">Prime Video</a></li>
            <li><a href="#">Registry</a></li>
            <li><a href="#">Gift Cards</a></li>
            <li><a href="#">Customer Service</a></li>
            <li><a href="#">Sell</a></li>
        </ul>
    </nav>

    <main class="main-content">

       
        <div class="hero-banner">
            <button class="hero-arrow left" id="prev" type="button" aria-label="Previous">&#8249;</button>
            <div class="slide active">
                <h1>Toys for little ones</h1>
                <a href="#" class="shop-now-btn">Shop now</a>
                <div class="banner-toys"></div>
            </div>
            <div class="slide">
                <h1>Desk setup deals</h1>
                <a href="#" class="shop-now-btn">Shop now</a>
                <div class="banner-toys"></div>
            </div>
            <div class="slide">
                <h1>Fashion for less</h1>
                <a href="#" class="shop-now-btn">Shop now</a>
                <div class="banner-toys"></div>
            </div>
            <button class="hero-arrow right" id="next" type="button" aria-label="Next">&#8250;</button>
        </div>

       
        <section class="product-grid">
            <div class="product-card">
                <h3>Get your game on</h3>
                <div class="tiles one">
                    <div class="tile"><div class="img big" style="background:linear-gradient(135deg,#5b2a86,#e0457b)"> <img src="~/Content/Image/pc.jpg" style="width:200px" /></div></div>
                </div>
                <a href="#" class="see-more">Shop gaming</a>
            </div>
            <div class="product-card">
                <h3>Shop Fashion for less</h3>
                <div class="tiles">
                    <div class="tile"><div class="img"><img src="~/Content/Image/jean.jpg"style="width:50px"  /></div>Jeans under $30</div>
                    <div class="tile"><div class="img"><img src="~/Content/Image/tops.jpg" style="width:80px" /></div>Tops under $25</div>
                    <div class="tile"><div class="img"><img src="~/Content/Image/dresses.jpg" style="width:70px" /></div>Dresses under $30</div>
                    <div class="tile"><div class="img"> <img src="~/Content/Image/giay.jpg" style="width:80px"   /></div>Shoes under $50</div>
                </div>
                <a href="#" class="see-more">See all deals</a>
            </div>
            <div class="product-card">
                <h3>Shop for your home essentials</h3>
                <div class="tiles">
                    <div class="tile"><div class="img"><img src="~/Content/Image/cleaning.jpg" style="width:80px" /></div>Cleaning Tools</div>
                    <div class="tile"><div class="img"><img src="~/Content/Image/home st.jpg" style="width:80px" /></div>Home Storage</div>
                    <div class="tile"><div class="img"><img src="~/Content/Image/decor.jpg" style="width:80px" /></div>Home Decor</div>
                    <div class="tile"><div class="img"><img src="~/Content/Image/bed.jpg" style="width:80px" /></div>Bedding</div>
                </div>
                <a href="#" class="see-more">Discover more in Home</a>
            </div>
            <div class="product-card">
                <h3>Refresh your space</h3>
                <div class="tiles">
                    <div class="tile"><div class="img"><img src="~/Content/Image/dining.jpg" style="width:80px" /></div>Dining</div>
                    <div class="tile"><div class="img"><img src="~/Content/Image/home.jpg" style="width:80px" /></div>Home</div>
                    <div class="tile"><div class="img"><img src="~/Content/Image/kitchen.jpg" style="width:80px" /></div>Kitchen</div>
                    <div class="tile"><div class="img"><img src="~/Content/Image/heath.jpg" style="width:80px" /></div>Health and Beauty</div>

                </div>
                <a href="#" class="see-more">See more</a>
            </div>
            
        </section>

    </main>

  
    <footer class="amazon-footer">
        <div class="back-to-top" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })">Back to top</div>
        <div class="footer-links">
            <div class="footer-column">
                <h4>Get to Know Us</h4>
                <a href="#">Careers</a>
                <a href="#">Blog</a>
                <a href="#">About Amazon</a>
            </div>
            <div class="footer-column">
                <h4>Make Money with Us</h4>
                <a href="#">Sell products on Amazon</a>
                <a href="#">Sell on Amazon Business</a>
                <a href="#">Become an Affiliate</a>
            </div>
            <div class="footer-column">
                <h4>Amazon Payment Products</h4>
                <a href="#">Amazon Business Card</a>
                <a href="#">Shop with Points</a>
                <a href="#">Reload Your Balance</a>
            </div>
            <div class="footer-column">
                <h4>Let Us Help You</h4>
                <a href="#">Your Account</a>
                <a href="#">Returns Centre</a>
                <a href="#">Help</a>
            </div>
        </div>
        <div class="footer-bottom">
            Conditions of Use &nbsp;|&nbsp; Privacy Notice &nbsp;|&nbsp; Your Ads Privacy Choices<br /><br />
            &copy; 1996-2026, Amazon.com, Inc. (Bản mô phỏng học tập)
        </div>
    </footer>
</body>
</html>